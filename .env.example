# Extra origins allowed to reach the Next.js dev server (next dev only).
# Comma-separated. Add your machine's LAN IP so you can open the site from a
# phone on the same network. Defaults to "localhost,127.0.0.1" when unset.
ALLOWED_DEV_ORIGINS=

# Application URL (used for auth redirects, emails, and canonical links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js / NextAuth v5 Secret (generate with `npx auth secret` or `openssl rand -base64 33`)
AUTH_SECRET=your_nextauth_auth_secret_here

# Google OAuth Provider (Google Cloud Console OAuth 2.0 Credentials)
AUTH_GOOGLE_ID=your_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret

# Neon Postgres Database URLs (Pooled connection for queries, Direct for migrations)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
DIRECT_URL=postgresql://user:password@ep-sample.eu-central-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15

# Brevo Transactional Email API Key (for verification OTPs, passwords, notifications)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Cloudinary Storage URL (for image uploads: events, gallery, carousel, user profile avatars)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
