# Extra origins allowed to reach the Next.js dev server (next dev only).
# Comma-separated. Add your machine's LAN IP so you can open the site from a
# phone on the same network. Defaults to "localhost,127.0.0.1" when unset.
#
# Example:
# ALLOWED_DEV_ORIGINS=192.168.1.50,my-laptop.local
ALLOWED_DEV_ORIGINS=
