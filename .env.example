# Extra origins allowed to reach the Next.js dev server (next dev only).
# Comma-separated. Add your machine's LAN IP so you can open the site from a
# phone on the same network. Defaults to "localhost,127.0.0.1" when unset.
ALLOWED_DEV_ORIGINS=

# Neon Postgres Database URL
DATABASE_URL=postgresql://user:password@ep-sample-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Cloudinary Storage URL
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
