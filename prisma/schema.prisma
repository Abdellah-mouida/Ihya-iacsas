generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model CarouselPost {
  id        String   @id @default(cuid())
  imageUrl  String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

model GalleryPhoto {
  id        String   @id @default(cuid())
  imageUrl  String
  captionAr String?
  captionEn String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Event {
  id            String    @id @default(cuid())
  slug          String    @unique
  titleAr       String
  titleEn       String
  descriptionAr String
  descriptionEn String
  date          DateTime
  time          String
  location      String
  posterUrl     String
  isNew         Boolean   @default(false)
  bookingOpen   Boolean   @default(true)
  capacityType  String    @default("OPEN")
  capacity      Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]

  @@index([date])
  @@index([bookingOpen])
  @@index([capacityType])
}

model Booking {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName      String
  email         String
  city          String
  age           Int
  motive        String?
  confirmed     Boolean  @default(false)
  status        String   @default("CONFIRMED")
  waitlistOrder Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([eventId, email])
  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([email])
  @@index([createdAt])
  @@index([status])
  @@index([eventId, status])
}

model OtpVerification {
  id        String    @id @default(cuid())
  email     String
  otpHash   String
  purpose   String    @default("BOOKING_VERIFY")
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  eventId   String?
  fullName  String?
  city      String?
  age       Int?
  motive    String?

  @@index([email])
  @@index([purpose])
  @@index([createdAt])
  @@index([eventId])
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String?   @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String?
  city                  String?
  age                   Int?
  imagePublicId         String?
  locale                String?   @default("ar")
  role                  Role      @default(USER)
  lastLoginAt           DateTime?
  lastActiveAt          DateTime?
  onboardingCompletedAt DateTime?
  termsAcceptedAt       DateTime?
  termsVersion          String?
  mustChangePassword    Boolean   @default(false)
  tempPasswordHash      String?
  tempPasswordExpiresAt DateTime?
  sessionVersion        Int       @default(1)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  bookings  Booking[]
  auditLogs AuditLog[]

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([expiresAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

model SystemSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
